# Preamble for bsdinstall automated installation
export nonInteractive="YES"
export DISTRIBUTIONS="base.txz kernel.txz"
export BSDINSTALL_DISTDIR="/usr/freebsd-dist"

# Partitioning: auto-partition vtbd0 without swap (all space allocated to root /)
PARTITIONS="vtbd0 { auto freebsd-ufs / }"

#!/bin/sh
# Post-installation setup script (runs inside chroot)

# Network configuration: generic DHCP for any interface
sysrc hostname="freebsd14.localdomain"
sysrc ifconfig_DEFAULT="DHCP"

# SSH daemon configuration
sysrc sshd_enable="YES"
echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

# Set root password to 'freebsd'
echo "freebsd" | pw user mod root -h 0

# Serial & video console configuration for libvirt (virsh console)
cat << 'EOF' >> /boot/loader.conf
autoboot_delay="1"
boot_multicons="YES"
boot_serial="YES"
comconsole_speed="115200"
console="comconsole,vidconsole"
kern.geom.label.gpt.enable="1"
kern.geom.label.ufs.enable="1"
EOF

# Enable serial console login on ttyu0
sed -i '' -e 's/ttyu0.*$/ttyu0\t"\/usr\/libexec\/getty std.115200"\tvt100\tonifconsole secure/' /etc/ttys

# Setup DNS resolution inside chroot so pkg can resolve repositories
# GW=$(netstat -rn -f inet | awk '$1 == "default" {print $2}')
# [ -n "$GW" ] && echo "nameserver $GW" > /etc/resolv.conf
echo "nameserver 10.0.2.3" >> /etc/resolv.conf
echo "nameserver 1.1.1.1" >> /etc/resolv.conf

# Initialize SSL root certificate store for HTTPS fetching
certctl rehash

# Package installation (non-interactive)
export ASSUME_ALWAYS_YES=YES
pkg bootstrap -f -y
pkg update
pkg install -y qemu-guest-agent doas curl ca_root_nss

if [ -f /usr/local/etc/rc.d/qemu-guest-agent ]; then
    sysrc qemu_guest_agent_enable="YES"
    sysrc qemu_guest_agent_flags="-d -v -l /var/log/qemu-ga.log"
fi

if [ -x /usr/local/bin/doas ]; then
    echo "permit keepenv :wheel" > /usr/local/etc/doas.conf
    chown root:wheel /usr/local/etc/doas.conf
    chmod 0400 /usr/local/etc/doas.conf
fi

# Set timezone
ln -sf /usr/share/zoneinfo/Europe/Warsaw /etc/localtime

# Golden template cleanup: remove unique IDs, keys, logs, and entropy
rm -f /etc/ssh/ssh_host_*
rm -f /etc/hostid
rm -rf /etc/resolv.conf
rm -f /var/db/entropy*
rm -f /var/db/dhclient.leases.*
rm -rf /tmp/* /var/tmp/*
rm -f /root/.history /root/.bash_history
find /var/log -type f -exec truncate -s 0 {} +

# Enable first-boot services: auto hostid generation and filesystem expansion
sysrc hostid_enable="YES"
sysrc growfs_enable="YES"

# Safe power off when installation finishes
poweroff
